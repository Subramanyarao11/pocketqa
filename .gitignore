# React Native bundle output. `react-native bundle` writes the JS bundle and the
# assets it references into the Android source tree; both are build products.
apps/pocketqa-mobile/android/app/src/main/assets/index.android.bundle
apps/pocketqa-mobile/android/app/src/main/assets/index.android.bundle.map
apps/pocketqa-mobile/android/app/src/main/res/drawable-*/
apps/pocketqa-mobile/android/app/src/main/res/raw/

# Generated diffs kept out of the tree; use git format-patch when one is needed.
*.patch
