<?xml version="1.0" encoding="utf-8"?>
<!--
  PocketQA capture-service configuration.

  Scope is enforced at runtime rather than declared here.

  `android:packageNames` used to pin this service to the Demo Shop, which meant
  PocketQA could only ever record its own sample app — the OS dropped every event
  from anywhere else before the service saw it. Removing it lets the operator
  target any installed app.

  Nothing is loosened by that. The service already drops every event whose
  package is not the *current session's* selected target, and again if the
  package is one that is never targetable (PocketQA itself, system UI, settings,
  the permission controller). Capture only ever runs inside a session the
  operator explicitly started against an app they explicitly chose, so the scope
  is now per session instead of per build.

  `flagReportViewIds` is what populates `AccessibilityNodeInfo.viewIdResourceName`.
  Without it that field is null for every classic Android View, so PocketQA saw
  no resource ids at all on a View/XML app and had to fall back to labels. It
  went unnoticed because Compose surfaces `testTagsAsResourceId` through a
  different route, and every target until now was Compose. It reports ids the
  app already publishes; it grants no access to content we could not read.

  `flagRetrieveInteractiveWindows` is what populates `getWindows()`. Without it
  the only way to reach a tree is `rootInActiveWindow`, which is null whenever
  something other than the app owns the active window — the soft keyboard after
  a typeText step, a system dialog, or simply a window transition still in
  flight. Replay then reported "accessibility service unavailable" while the
  service was in fact connected and bound. The flag grants no new data: window
  content was already retrievable, this only lets us ask for the target's own
  window instead of whichever one happens to be active.

   * events other than window-content changes are filtered client-side;
   * screenshot is requested per-window only from the service, never
     via MediaProjection or arbitrary display capture.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged|typeViewClicked|typeViewFocused|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:notificationTimeout="80"
    android:canRetrieveWindowContent="true"
    android:canRequestTouchExplorationMode="false"
    android:canPerformGestures="false"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description" />
