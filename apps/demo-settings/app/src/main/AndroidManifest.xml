<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:label="Demo Settings"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <meta-data
            android:name="pocketqa.fixtures"
            android:value="reset,all-enabled,restricted-profile" />
        <!--
          How PocketQA asks this app to reach a fixture. Declaring the URI here
          keeps the deep link app-owned: the capture and replay engines never
          need to know this app's scheme, and setPackage stops anything else
          claiming the link.
        -->
        <meta-data
            android:name="pocketqa.fixtureUriTemplate"
            android:value="demosettings://reset?fixture={fixture}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Demo Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="demosettings" android:host="reset" />
            </intent-filter>
        </activity>
    </application>
</manifest>
