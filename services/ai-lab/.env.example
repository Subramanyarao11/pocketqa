# Copy to .env. Never commit .env. See CONTRIBUTING.md "Data and secrets".

# OpenRouter (interim connected engine, AI-B-02). OPENAI_API_KEY also works.
OPENROUTER_API_KEY=

# Quality ceiling: what a task can achieve at all.
POCKETQA_LLM_MODEL=google/gemini-2.5-flash

# On-device proxy: same family LiteRT/MediaPipe deploys on the phone. A prompt
# that fails here will not survive the ML Kit Prompt port either.
POCKETQA_DEVICE_PROXY_MODEL=google/gemma-3-4b-it

POCKETQA_TIMEOUT_MS=30000
POCKETQA_MAX_RETRIES=3
